<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>Bonxie</AssemblyName>
        <AssemblyTitle>Bonxie</AssemblyTitle>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyMetadata Include="Skua.ClientId" Value="BonxieAvalonia" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Skia" />
        <PackageReference Include="Avalonia.X11" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />

        <PackageReference Include="Material.Avalonia" />
        <PackageReference Include="Material.Icons" />
        <PackageReference Include="Material.Icons.Avalonia" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Skua.Core\Skua.Core.csproj" />
        <ProjectReference Include="..\Skua.Core.Interfaces\Skua.Core.Interfaces.csproj" />
        <ProjectReference Include="..\Skua.Core.Models\Skua.Core.Models.csproj" />
        <ProjectReference Include="..\Skua.Shared.Avalonia\Skua.Shared.Avalonia.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <Content Include="QuestData.json">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="AdvancedSkills.json">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Skua.AS3\skua\bin\skua.swf" Link="skua.swf" Condition="Exists('..\Skua.AS3\skua\bin\skua.swf')">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!--
      The game player: the Skua build of Mugetsu (GPL-3.0, source at https://github.com/retr0gr4d3/skua-mugetsu).
      It is downloaded once into player/<version>-linux/ at the repository root and copied to the output's player/ folder.
      To try a local build of the player instead, pass -p:SkuaPlayerLocal=<folder with Mugetsu>.
    -->
    <PropertyGroup>
        <SkuaPlayerExe>Mugetsu</SkuaPlayerExe>
        <SkuaPlayerCache>$(MSBuildThisFileDirectory)..\player\$(SkuaPlayerVersion)-$(SkuaPlayerOs)</SkuaPlayerCache>
        <SkuaPlayerDir Condition="'$(SkuaPlayerLocal)' != ''">$(SkuaPlayerLocal)</SkuaPlayerDir>
        <SkuaPlayerDir Condition="'$(SkuaPlayerLocal)' == ''">$(SkuaPlayerCache)\Mugetsu</SkuaPlayerDir>

        <!-- The x86-64-v2 build for CPUs without AVX2, copied to player-x86-64-v2/; Bonxie picks it at startup when
             the CPU lacks AVX2. Releases before it existed don't have it: the build then warns and ships only player/. -->
        <SkuaPlayerAvxCache>$(SkuaPlayerCache)-x86-64-v2</SkuaPlayerAvxCache>
        <SkuaPlayerAvxDir Condition="'$(SkuaPlayerAvxDir)' == '' And '$(SkuaPlayerV2Local)' != ''">$(SkuaPlayerV2Local)</SkuaPlayerAvxDir>
        <SkuaPlayerAvxDir Condition="'$(SkuaPlayerAvxDir)' == ''">$(SkuaPlayerAvxCache)\Mugetsu</SkuaPlayerAvxDir>
    </PropertyGroup>

    <Target Name="DownloadSkuaPlayer" Condition="'$(SkuaPlayerLocal)' == '' And !Exists('$(SkuaPlayerDir)\$(SkuaPlayerExe)')">
        <MakeDir Directories="$(SkuaPlayerCache)" />
        <DownloadFile SourceUrl="https://github.com/retr0gr4d3/skua-mugetsu/releases/download/v$(SkuaPlayerVersion)/linux.tar.gz" DestinationFolder="$(SkuaPlayerCache)" DestinationFileName="player.tar.gz" />
        <Exec Command="tar -xzf player.tar.gz" WorkingDirectory="$(SkuaPlayerCache)" />
    </Target>

    <Target Name="DownloadSkuaPlayerAvx" Condition="'$(SkuaPlayerLocal)' == '' And '$(SkuaPlayerV2Local)' == '' And '$(SkuaPlayerAvxDir)' == '$(SkuaPlayerAvxCache)\Mugetsu' And !Exists('$(SkuaPlayerAvxDir)\$(SkuaPlayerExe)')">
        <MakeDir Directories="$(SkuaPlayerAvxCache)" />
        <DownloadFile SourceUrl="https://github.com/retr0gr4d3/skua-mugetsu/releases/download/v$(SkuaPlayerVersion)/linux-x86-64-v2.tar.gz" DestinationFolder="$(SkuaPlayerAvxCache)" DestinationFileName="player-v2.tar.gz" />
        <Exec Command="tar -xzf player-v2.tar.gz" WorkingDirectory="$(SkuaPlayerAvxCache)" />
    </Target>

    <Target Name="AddSkuaPlayer" BeforeTargets="AssignTargetPaths" DependsOnTargets="DownloadSkuaPlayer;DownloadSkuaPlayerAvx">
        <ItemGroup>
            <_SkuaPlayerFile Include="$(SkuaPlayerDir)\**" />
            <None Include="@(_SkuaPlayerFile)" Link="player\%(_SkuaPlayerFile.RecursiveDir)%(_SkuaPlayerFile.Filename)%(_SkuaPlayerFile.Extension)" CopyToOutputDirectory="PreserveNewest" />
            <_SkuaPlayerAvxFile Condition="Exists('$(SkuaPlayerAvxDir)')" Include="$(SkuaPlayerAvxDir)\**" />
            <None Include="@(_SkuaPlayerAvxFile)" Link="player-x86-64-v2\%(_SkuaPlayerAvxFile.RecursiveDir)%(_SkuaPlayerAvxFile.Filename)%(_SkuaPlayerAvxFile.Extension)" CopyToOutputDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

</Project>
